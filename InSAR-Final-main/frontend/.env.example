# InSAR frontend — environment template. Copy to `.env`.
# Vite only exposes vars prefixed with VITE_ to the client, and they are COMPILED INTO
# the bundle at build time (publicly visible in the browser). No secrets here — these are
# for pointing the app at the right Weespas instance per environment, not for secrecy.
# The app falls back to the localhost dev defaults below when a var is unset, so this file
# is optional in local dev and REQUIRED at build time for any non-local deploy.

# Base URL of the Weespas backend API (the /api/v1 base). Used for the access-gate token
# verify (/insar/verify), the data-bundle fetches, and the usage-telemetry sink.
VITE_WEESPAS_API=http://localhost:8000/api/v1

# Base URL of the Weespas user-facing web app's login page. Two uses:
#   1. the access gate bounces tokenless visitors here (?next=insar resumes the map),
#   2. its ORIGIN backs the "← Back to Weespas" breadcrumb on the map (must be the web
#      app, NOT the API origin above, or the back-link lands on a 404).
VITE_WEESPAS_LOGIN_URL=http://localhost:5174/login
