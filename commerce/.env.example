# ──────────────────────────────────────────────────────────────────────────────
# Commerce service config. Copy to `.env` and fill in. Mirrors the weespas
# .env.example style. The service reads this at startup (restart to apply changes).
# ──────────────────────────────────────────────────────────────────────────────

# ---- Required ----
# Full SQLAlchemy URL for the commerce database (its OWN DB, decoupled from weespas/InSAR).
# Create it once: `createdb commerce`. PostGIS self-provisions on first boot.
DATABASE_URL=postgresql+psycopg2://commerce:commerce@localhost:5432/commerce

# ---- Deployment environment ----
# "development" (default) or "production". In production the app refuses to start
# unless a JWT public key is configured below (fail-closed boot guard).
COMMERCE_ENV=development
DEBUG=true

# ---- Auth: RS256 token verification (PUBLIC key only) ----
# This increment shares the weespas signing keypair. Commerce holds the PUBLIC half only:
# it can verify weespas-minted commerce tokens but can never forge one. Point this at the
# public PEM. (For weespas to actually SIGN RS256 — not the HS256 dev fallback — set
# INSAR_JWT_PRIVATE_KEY_PATH in weespas/.env too.)
COMMERCE_JWT_PUBLIC_KEY_PATH=/home/jeff/PE/dev/keys/insar_jwt_public.pem
# Or inline instead of a path (single line; literal \n is unescaped):
# COMMERCE_JWT_PUBLIC_KEY_INLINE=
COMMERCE_JWT_ALGORITHM=RS256
# Audience guard — a token must carry this scope. Distinct per service so a telemetry or
# mobility token can never authenticate against commerce.
COMMERCE_JWT_SCOPE=commerce_trade

# ---- CORS (origin-locked; tighten in prod) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---- Redis (reserved for the deferred settlement-path revocation denylist; unused now) ----
REDIS_URL=redis://localhost:6379/3

# ---- Proximity feed tuning (the ranking "algorithm" — explainable, tunable) ----
FEED_DEFAULT_RADIUS_M=2000
FEED_MAX_RADIUS_M=20000
FEED_PAGE_SIZE=20
FEED_MAX_PAGE_SIZE=50
FEED_MAX_CANDIDATES=500
FEED_W_DISTANCE=0.5
FEED_W_FRESHNESS=0.3
FEED_W_INTENT=0.2
FEED_FRESHNESS_HALFLIFE_H=24

# ---- Trending demo seeder (LOCAL/DEMO ONLY) ----
# A standalone helper (PE/dev/commerce-trending-demo.sh → services/trending_demo.py) that keeps a
# live, looping population of boosted PRODUCTS near a demo centre so the §8 trending rail visibly
# cycles in a dev stack. It FABRICATES synthetic sellers/listings/boosts and so is DOUBLE-gated
# off in production: this flag defaults false AND the process raises if COMMERCE_ENV=production.
# Set true ONLY in a local/demo stack. Cadence/size/centre have safe defaults in core/config.py
# (TRENDING_DEMO_GENERATIONS, _GEN_SIZE, _CYCLE_SECONDS, _CENTER_LAT/_LNG, _JITTER_DEG).
TRENDING_DEMO_ENABLED=false
