# ── InSAR read app (data API, :8002) — production env template ────────────────
# Copy to a real .env / secret store and fill in. See PE/SECURITY.md.
# Generate it locally for dev with the openssl recipe in PE/dev/keys/.gitignore.

# Mark this a production deploy → the app REFUSES TO START unless a public key is set
# (fail-closed boot guard). This is the switch that makes "forgot the key" a crash, not a
# silent data leak.
INSAR_ENV=production

# RS256 PUBLIC key only — this app VERIFIES tokens, it never mints them. Provide a path
# (preferred: mounted secret file) OR the inline PEM (INSAR_JWT_PUBLIC_KEY, "\n"-escaped).
INSAR_JWT_PUBLIC_KEY_PATH=/etc/secrets/insar_jwt_public.pem
INSAR_JWT_ALGORITHM=RS256
# Must equal Weespas's auth_service.INSAR_TELEMETRY_SCOPE.
INSAR_JWT_SCOPE=insar_telemetry

# CORS: the real InSAR frontend origin(s), comma-separated. NOT a wildcard.
INSAR_ALLOWED_ORIGINS=https://insar.weespas.example

# Per-account rate limiting (optional but recommended in prod). Unset REDIS_URL ⇒ disabled.
REDIS_URL=redis://127.0.0.1:6379/3
INSAR_RATE_LIMIT=120
INSAR_RATE_WINDOW_S=60

# Server-side access metering → Weespas §8. Full URL of the telemetry sink. Unset ⇒ the
# data API does NOT phone home (keeps the read app's no-live-network default).
WEESPAS_TELEMETRY_URL=https://api.weespas.example/api/v1/insar-telemetry/event
WEESPAS_TELEMETRY_TIMEOUT_S=2.0
