# ── Weespas API (identity + revenue, :8000) — production env template ─────────
# Only the security-relevant keys for the InSAR integration are shown here; see the
# weespas app's own .env.example for the full set (DB, M-Pesa, SMS, etc.).

# Mandatory (app fails fast without these).
DATABASE_URL=postgresql+psycopg2://USER:PASS@127.0.0.1:5432/weespas
SECRET_KEY=__set_a_long_random_secret__   # signs HS256 ACCESS tokens (not telemetry)

# HTTPS/cookie hardening. cookie_secure=True is ALSO the switch that turns on HSTS in the
# app (security_headers middleware) — set it in any TLS deployment.
COOKIE_SECURE=true

# ── InSAR telemetry token: RS256 signing (asymmetric trust) ───────────────────
# Weespas holds the PRIVATE key (sign + verify). The InSAR read app gets only the public
# half. Provide paths to mounted secret files.
INSAR_JWT_PRIVATE_KEY_PATH=/etc/secrets/insar_jwt_private.pem
INSAR_JWT_PUBLIC_KEY_PATH=/etc/secrets/insar_jwt_public.pem
INSAR_JWT_ALGORITHM=RS256

# Rollout cleanup (step 5): leave FALSE during the HS256→RS256 overlap so in-flight legacy
# tokens still verify. Flip to true ONCE one token TTL (insar_telemetry_token_ttl_min,
# default 120 min) has elapsed past the minter cutover — then telemetry tokens are pinned
# to RS256 (access tokens still use HS256, unaffected).
INSAR_TELEMETRY_REQUIRE_RS256=false

# Where the InSAR SPA is served + where to bounce an unauthenticated InSAR visitor.
INSAR_PUBLIC_URL=https://insar.weespas.example
WEESPAS_LOGIN_URL=https://app.weespas.example/login
INSAR_TELEMETRY_TOKEN_TTL_MIN=120
