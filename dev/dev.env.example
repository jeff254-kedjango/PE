# PE/dev/dev.env  — shared local-dev config sourced by the launchers in PE/dev/.
# Copy to dev.env and fill in. Everything here is OPTIONAL: the servers run
# without it (some features just stay inert). NEVER commit dev.env with secrets.

# Shared admin token between the InSAR control API and the Weespas auto-rebuild
# trigger. The control API refuses to start refreshes (503) unless this is set,
# and Weespas only fires a rebuild when its INSAR_ADMIN_TOKEN matches. Pick any
# long random string and put the SAME value in weespas/.env as INSAR_ADMIN_TOKEN.
INSAR_ADMIN_TOKEN=

# Redis DB layout (already separated, listed here for clarity — no need to change):
#   weespas cache   → redis://localhost:6379/0
#   weespas celery  → redis://localhost:6379/1
#   InSAR celery    → redis://localhost:6379/2
# REDIS_URL=redis://localhost:6379/2

# Path to the InSAR analytical DuckDB. Weespas reads it (read-only) to resolve a
# listing→footprint and serve the listing RISK PILL (GET /insar/listing/{id}/risk)
# and the deep-link fly-to. UNSET ⇒ the resolver returns coverage="unavailable"
# (honest: never "safe") and the pill shows "Risk data unavailable". Set this to
# light up the badge in local dev (mirror it in weespas/.env too).
INSAR_DUCKDB_PATH=/home/jeff/PE/InSAR-Final-main/backend/data/demo.duckdb
