# Weespas backend — environment template.
# Copy to `.env` and fill in real values. `.env` is git-ignored; this file is
# committed as documentation and MUST NOT contain real secrets.
#
# Settings are loaded by pydantic-settings (core/config.py); names are
# case-insensitive (DATABASE_URL → database_url).

# ─── Required (app fails to start without these) ────────────────────────
# Full SQLAlchemy database URL.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/commercial
# JWT signing secret. Use a long random string. Rotating it logs all users out.
SECRET_KEY=change-me-to-a-long-random-string

# ─── Auth ───────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── App ──────────────────────────────────────────────────────────────--
# DEBUG=true exposes OTP codes in dev responses/logs — keep false in prod.
DEBUG=true
# COOKIE_SECURE=true requires HTTPS for the session cookie — set true in prod.
COOKIE_SECURE=false
# CORS allow-list (comma-separated browser origins). Default = local Vite dev ports.
# In PROD set this to the real frontend origin(s) ONLY. Leave unset in dev.
# CORS_ORIGINS=https://app.weespas.co.ke

# ─── Africa's Talking SMS ────────────────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# ─── Analytics / GeoIP ───────────────────────────────────────────────────
GEOIP_DB_PATH=data/GeoLite2-City.mmdb
ANALYTICS_CACHE_TTL=300

# ─── Redis / Celery ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
FEED_CACHE_TTL=300
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Per-feature Celery offload flags (default off; flip on one at a time in prod).
CELERY_SEND_OTP_ENABLED=false
CELERY_LOG_SEARCH_ENABLED=false
CELERY_RECORD_VIEW_ENABLED=false
CELERY_SESSION_GEO_ENABLED=false
CELERY_LAST_SEEN_ENABLED=false
CELERY_BEAT_ENABLED=false
CELERY_FEED_WARM_ENABLED=false

# ─── InSAR integration (P4a) ──────────────────────────────────────────────
# Path to the InSAR read-only DuckDB (building footprints + danger tiers) that the
# listing→footprint resolver matches against. Empty ⇒ integration disabled: the
# resolver returns "unavailable"/"not monitored" rather than guessing. Read-only.
INSAR_DUCKDB_PATH=
# Max metres a listing point may sit outside a footprint and still resolve to it.
INSAR_MATCH_RADIUS_M=30
# --- Disambiguating resolver (the "bad pin" problem) ---
# Radius (m) in which ALL candidate footprints are gathered for attribute-aware ranking
# (a dropped pin in dense areas sits near several buildings). Default 15.
INSAR_BUFFER_RADIUS_M=15
# Radius (m) over which a `land` listing's ground movement is estimated from neighbouring
# monitored buildings (land has no footprint of its own). Default 40.
INSAR_LAND_AGGREGATE_RADIUS_M=40
# If the top-2 candidate scores are within this gap, the match is AMBIGUOUS →
# needs_confirmation (owner taps the right building) rather than an auto-snap. Default 0.15.
INSAR_AMBIGUITY_SCORE_GAP=0.15
# Max candidates persisted/offered for confirmation per listing (UI shows 2-4). Default 6.
INSAR_MAX_CANDIDATES=6
# Directory the structural-flag exporter writes <aoi>.json into — the same dir the
# InSAR build's fetch_structural_flags() reads. Empty ⇒ export disabled.
INSAR_FLAGS_EXPORT_DIR=
# InSAR pipeline control-API base URL + its admin token (X-Admin-Token). When BOTH
# are set, recording a flag also fires a debounced rebuild of that AOI so the flag
# reaches the score without a manual re-seed. Empty URL ⇒ no auto-rebuild (export
# still happens; an operator rebuilds when ready).
INSAR_CONTROL_API_URL=
INSAR_ADMIN_TOKEN=
# Best-effort trigger timeout (seconds); the rebuild itself is async on the InSAR side.
INSAR_CONTROL_TIMEOUT_S=3

# ─── Billing: listing-location access (M-Pesa Daraja STK Push) ────────────
# The paid "reveal" tiers (see PE/billing_architecture.md). Billing is DISABLED
# until consumer_key + consumer_secret + shortcode + passkey are all set
# (settings.is_billing_enabled); with them empty, /reveal still works on the free
# hook tier and /billing/checkout returns 503. No secrets belong in the repo —
# fill these from your Daraja app (sandbox: https://developer.safaricom.co.ke).
# "sandbox" (default) or "production". When "production" the live Daraja host is
# used regardless of MPESA_BASE_URL (guards against a stale sandbox URL going live).
MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Lipa na M-Pesa Online shortcode (sandbox Paybill is 174379) + its Lipa passkey.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS URL Safaricom POSTs the STK result to (e.g. an ngrok tunnel in dev).
# Must reach POST /api/v1/billing/mpesa/callback. Empty in dev ⇒ rely on polling +
# the reconciliation sweep instead of the callback.
MPESA_CALLBACK_URL=
# Daraja HTTP timeout (seconds).
MPESA_TIMEOUT_S=10
# M-Pesa callback IP allow-list (comma-separated). EMPTY = no check (sandbox/dev).
# In prod set to Safaricom's callback IPs; non-listed callers are ignored (still 200).
# MPESA_CALLBACK_ALLOWED_IPS=196.201.214.200,196.201.214.206
# Checkout STK-spam rate-limit (per user, fixed window). Fail-open on Redis error.
CHECKOUT_RATE_MAX=5
CHECKOUT_RATE_WINDOW_S=300
# Deterministic public-coordinate blur radius (metres) for un-revealed listings.
BILLING_FUZZ_RADIUS_M=1000

# ---- §8: metering & company-detection policy engine ----
# The commercial-likelihood score crossing this triggers a SOFT upsell (business
# plan), never a block. Tunable lever; see commercial_model.md §7.2.
COMPANY_SCORE_THRESHOLD=0.6
COMPANY_SCORE_WINDOW_DAYS=30
# Counts that saturate each signal to 1.0 (a normal house-hunter is far below).
COMPANY_VOLUME_SATURATION=50
COMPANY_BREADTH_SATURATION=4
COMPANY_EXPORT_SATURATION=5
# Comma-separated corporate email domains (one non-decisive signal among several).
COMPANY_EMAIL_DOMAINS=kcbgroup.com,equitybank.co.ke,equitygroupholdings.com,britam.com,jubileeinsurance.com,co-opbank.co.ke,absa.co.ke,ncbagroup.com
